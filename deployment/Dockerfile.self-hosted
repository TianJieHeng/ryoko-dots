# Operator pins the reviewed Node image digest before target-host qualification.
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && node scripts/check-production-boundary.mjs .

FROM ${NODE_IMAGE} AS app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4310 DATABASE_PATH=/state/dots.sqlite
WORKDIR /app
# Python is for the offline lifetime gate. A configured Ryoko producer also needs
# a reviewed interpreter/environment in its own qualified derivative image.
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci --omit=dev && mkdir -p /state /gate && chown node:node /state /gate && chmod 0700 /state /gate
COPY --from=build /app/dist ./dist
COPY scripts/operations ./scripts/operations
USER node
EXPOSE 4310
ENTRYPOINT ["/usr/bin/python3", "/app/scripts/operations/lifetime_gate.py", "--gate", "/gate/state.lock", "--"]
CMD ["/usr/local/bin/node", "/app/dist/server/server/index.js"]
