  "pins": {
    "consumerCommit": "replace-with-exact-reviewed-commit",
    "producerCommit": "replace-with-exact-reviewed-commit",
    "producerSchemaSha256": "replace-with-actual-schema-digest",
    "operatorConfigSha256": "replace-with-non-secret-config-digest"
  }
