# Example only. No user, directory, credential, service or network is created.
# Choose reviewed absolute paths and an existing non-root service account.
[Unit]
Description=Ryoko Dots single self-hosted owner
After=network.target

[Service]
Type=simple
User=dots
Group=dots
WorkingDirectory=/opt/dots
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4310
Environment=DATABASE_PATH=/var/lib/dots/state/dots.sqlite
Environment=OWNER_TOKEN_FILE=/run/credentials/dots.service/owner-token
Environment=APP_ORIGIN=https://dots.example
Environment=TLS_PROXY=1
# Supplying an existing operator secret is explicit deployment work, not setup.
LoadCredential=owner-token:/etc/dots/owner-token
ExecStart=/usr/bin/python3 /opt/dots/scripts/operations/lifetime_gate.py --gate /var/lib/dots/gate/state.lock -- /usr/bin/node /opt/dots/dist/server/server/index.js
KillMode=control-group
TimeoutStopSec=40
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dots/state /var/lib/dots/gate
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2G
TasksMax=256
# A configured producer checkout/interpreter/profile plus artifact roots must
# be explicitly readable/writable here; add only reviewed exact paths.

[Install]
WantedBy=multi-user.target
