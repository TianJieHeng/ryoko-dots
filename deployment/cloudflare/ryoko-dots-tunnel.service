# Install as a user unit. Enable ONLY after Cloudflare login and owner approval.
[Unit]
Description=Ryoko Dots API-only Cloudflare Tunnel
After=network-online.target ryoko-dots-api-edge.service
Wants=network-online.target
Requires=ryoko-dots-api-edge.service
ConditionPathExists=%h/.config/ryoko-dots/cloudflare/config.yml

[Service]
ExecStart=/usr/bin/cloudflared --no-autoupdate --config %h/.config/ryoko-dots/cloudflare/config.yml tunnel run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
