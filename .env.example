# SELF-HOSTED SERVER CONFIGURATION: conversation storage is qualified in BE02.
# New browser controls require qualified /api/runtime adapters (BE00–BE12).
# Frontend-only preview needs no Intelligence/model/channel credentials:
# npm run build:frontend && npm run preview:frontend
# Optional loopback preview port:
# FRONTEND_PORT=4173
# Production startup imports only the self-hosted BFF; legacy provider entries below are inactive.

# OpenDots template: the UI opens in setup state until these fields are configured.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns the Dots workspace and authenticated mappings.
OWNER_ID=opendots-owner
# npm run dev allows http://127.0.0.1:5173; override for a different exact origin.
# APP_ORIGIN=http://127.0.0.1:5173
# Required for every owner login (24–4096 characters); no unauthenticated local bypass.
# Use an existing secret from your deployment secret facility; no browser storage.
# OWNER_TOKEN=
# Direct external binding requires native HTTPS (both paths) and HTTPS APP_ORIGIN.
# TLS_CERT_PATH=/private/path/certificate.pem
# TLS_KEY_PATH=/private/path/key.pem
# Alternatively terminate HTTPS at a proxy with HOST on loopback and explicit:
# TLS_PROXY=1
# APP_ORIGIN=https://dots.example
# Proxy preserves the canonical Host; forwarded headers are never trusted.

# Absolute trusted JSON launcher configuration; see docs/runtime/self-hosted-conversations.md.
# Omit for honest unconfigured capabilities; no provider or Intelligence key is required.
# RYOKO_CONFIG_PATH=/private/path/ryoko-dots.json

# LEGACY RETIREMENT CONFIGURATION BELOW: ignored by production self-hosted startup.
INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL=
# INTELLIGENCE_WS_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional isolated read-only public-page browser. No search service is bundled.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional realtime speech; compute uses the same configured Intelligence thread.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional managed Slack channel; see docs/SETUP.md#slack.
# Match the managed declaration name, not a Slack #conversation name.
# OpenTag calls this INTELLIGENCE_CHANNEL_NAME; OpenDots uses SLACK_CHANNEL_NAME.
# Allowlist both the Slack workspace and explicit Slack user IDs.
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# Optional exact target-host qualification receipt. Synthetic evidence is rejected.
# No executor capability is enabled by setting a URL or a token alone.
COMPUTER_QUALIFICATION_PATH=
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock
