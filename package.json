{
  "name": "opendots",
  "version": "0.1.0",
  "description": "Ryoko Dots frontend consumer with explicit self-hosted runtime qualification gates.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env scripts/start-self-hosted.mjs --development\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env scripts/start-self-hosted.mjs",
    "browser": "node --env-file-if-exists=.env --import tsx src/browser/index.ts",
    "browser:start": "node --env-file-if-exists=.env dist/server/browser/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts vite.config.ts",
    "format": "prettier --write src tests scripts *.json *.ts *.js index.html public .github Dockerfile \"compose*.yml\" deployment README.md docs .env.example --ignore-unknown",
    "check-format": "prettier --check src tests scripts *.json *.ts *.js index.html public .github Dockerfile \"compose*.yml\" deployment README.md docs .env.example --ignore-unknown",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "preview:frontend": "node scripts/serve-frontend.mjs",
    "check:runtime-contract": "node scripts/check-runtime-contract.mjs",
    "test:runtime-stdio": "node scripts/test-runtime-stdio.mjs",
    "check:production-boundary": "node scripts/check-production-boundary.mjs .",
    "test:operations": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:production-boot": "node scripts/test-production-boot.mjs"
  },
  "keywords": [],
  "author": "Atai Barkai",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "ajv": "^6.15.0",
    "hono": "^4.13.11",
    "lucide-react": "^1.48.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@copilotkit/channels": "^0.11.0",
    "@copilotkit/core": "^1.75.0",
    "@copilotkit/runtime": "^1.75.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/ai": "^0.63.0",
    "@tanstack/ai-openai": "^0.25.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "rxjs": "^7.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CopilotKit/OpenDots.git"
  },
  "overrides": {
    "undici": "^6.29.0"
  }
}
